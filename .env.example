# ==== FedGuard configuration template ====
# Copy this file to `.env` and fill in your values.
# NEVER commit the real `.env` file to git.

# ---- Kaggle (dataset download for Phase 1) ----
KAGGLE_USERNAME=                 # kaggle.com -> Account -> Create New API Token
KAGGLE_KEY=

# ---- AWS (Phase 4 - EC2 node) ----
AWS_ACCESS_KEY_ID=               # IAM user key with EC2 permissions (not root)
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=              # e.g. us-east-1
AWS_EC2_KEYPAIR_NAME=            # name of the .pem keypair used for SSH
AWS_EC2_PUBLIC_IP=               # fill in AFTER the instance is launched in Phase 4

# ---- GCP (Phase 4 - Compute Engine node) ----
GCP_PROJECT_ID=
GCP_ZONE=                        # e.g. us-central1-a
GCP_SERVICE_ACCOUNT_JSON_PATH=   # local path to the downloaded service account JSON key
GCP_VM_PUBLIC_IP=                # fill in AFTER the instance is launched in Phase 4

# ---- Orchestrator (Flower server) ----
ORCHESTRATOR_PUBLIC_ADDRESS=     # public IP:port or ngrok/cloudflared URL the cloud clients connect to
FLOWER_SERVER_PORT=8080

# ---- GitHub ----
GIT_REPO_URL=
